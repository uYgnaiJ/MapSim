FIELDPOP 1
# LOW-CONFIDENCE HEURISTIC ESTIMATES, not a census or precise statistic.
# Mobile campaigning armies are not separately added to resident population.
map = England in 867
year = 867
model = rural-capacity-settlement-v1
confidence = low
target-total = 1200000
plausible-low = 800000
plausible-high = 1800000
rural-total = 1160200
settlement-total = 39800
hex-count = 4987
grid = EPSG:27700 | 100000 | 700000 | 3300
hex-area-km2 = 28.293049942
base-rural-density = 9.000
local-field = 1 + 0.07*sin(E/37000) + 0.05*cos(N/43000) + 0.03*sin((E+N)/57000)
apportionment = largest remainder; ties by q then r
generator = build/population_generate.py
sources = docs/population.md

