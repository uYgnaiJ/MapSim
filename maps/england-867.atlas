FIELDATLAS 3
name = England in 867
grid = EPSG:27700 | 100000 | 700000 | 3300

# Reconstruction after the Battle of York (21 March 867), before the Nottingham campaign.
# Canonical nonnegative three-axis IDs; one component of every occupied ID is zero.
# Right/left 100/011; upper-left/lower-right 010/101; lower-left/upper-right 001/110.
# York shows Danish military dominance, not the later Danelaw or post-876 settlement boundaries.
# Ecgberht's authority, western Northumbria, the Fens, upper Thames and Cornish frontier are uncertain.
# Geographic reference: ONS / Ordnance Survey (Crown copyright and database right 2016).
# Reference data licensed under OGL v3 and the OS OpenData Licence; modern borders are not historical claims.
[kingdoms]
# id | name | ruler
northumbria | Northumbria | Ecgberht I (client king)
york | Danish-held York | Great Heathen Army
mercia | Mercia | King Burgred
east-anglia | East Anglia | King Edmund
wessex | Wessex | King Æthelred I
cornwall | Cornwall (West Welsh) | Ruler unnamed in 867

